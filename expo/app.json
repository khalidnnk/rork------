{
  "expo": {
    "name": "Alsulaimani Athan",
    "slug": "alsulaimani-athan",
    "owner": "khalidnn",
    "version": "1.3.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alsulaimani-athan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1A1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.alsulaimani-athan",
      "buildNumber": "19",
      "appleTeamId": "4FX7S5KVYY",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم أذان السليماني موقعك أثناء استخدام التطبيق لتحديد مدينتك وحساب مواقيت الصلاة وجدولة تنبيهات الأذان حسب منطقتك.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يستخدم أذان السليماني موقعك في الخلفية عند سفرك إلى منطقة أخرى لتحديث مواقيت الصلاة وجدولة تنبيهات الأذان الصحيحة تلقائيًا، حتى دون فتح التطبيق. لا يتم حفظ سجل تحركاتك أو مشاركة موقعك.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.alsulaimani.athan"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1A1F"
      },
      "package": "app.rork.alsulaimani_athan",
      "versionCode": 3,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم أذان السليماني موقعك أثناء استخدام التطبيق لتحديد مدينتك وحساب مواقيت الصلاة وجدولة تنبيهات الأذان حسب منطقتك.",
          "locationAlwaysPermission": "يستخدم أذان السليماني موقعك في الخلفية عند سفرك إلى منطقة أخرى لتحديث مواقيت الصلاة وتنبيهات الأذان تلقائيًا.",
          "locationAlwaysAndWhenInUsePermission": "يستخدم أذان السليماني موقعك في الخلفية عند سفرك إلى منطقة أخرى لتحديث مواقيت الصلاة وجدولة تنبيهات الأذان الصحيحة تلقائيًا، حتى دون فتح التطبيق. لا يتم حفظ سجل تحركاتك أو مشاركة موقعك.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/haya_ala_salah.m4a",
            "./assets/audio/athan.m4a",
            "./assets/audio/allahu_akbar.m4a"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9112ce90-31a1-4a99-aa65-ab2ffc484062"
      }
    }
  }
}
