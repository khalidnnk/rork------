{
  "expo": {
    "name": "Alsulaimani Athan",
    "slug": "alsulaimani-athan",
    "owner": "khalidnn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alsulaimani-athan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1A1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.alsulaimani-athan",
      "buildNumber": "24",
      "appleTeamId": "4FX7S5KVYY",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Alsulaimani Athan uses your location while you use the app to identify your area, calculate prayer times, and schedule local Athan notifications."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.alsulaimani.athan"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1A1F"
      },
      "package": "app.rork.alsulaimani_athan",
      "versionCode": 3,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Alsulaimani Athan uses your location while you use the app to identify your area, calculate prayer times, and schedule local Athan notifications."
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/haya_ala_salah.m4a",
            "./assets/audio/allahu_akbar.m4a"
          ]
        }
      ]
    ],
    "locales": {
      "ar": {
        "CFBundleDisplayName": "أذان السليماني",
        "NSLocationWhenInUseUsageDescription": "يستخدم أذان السليماني موقعك أثناء استخدام التطبيق لتحديد مدينتك وحساب مواقيت الصلاة وجدولة تنبيهات الأذان حسب منطقتك."
      },
      "en": {
        "CFBundleDisplayName": "Alsulaimani Athan",
        "NSLocationWhenInUseUsageDescription": "Alsulaimani Athan uses your location while you use the app to identify your area, calculate prayer times, and schedule local Athan notifications."
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9112ce90-31a1-4a99-aa65-ab2ffc484062"
      }
    }
  }
}
